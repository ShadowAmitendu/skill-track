PORT=4000
NODE_ENV=development
DATABASE_URL="file:../prisma/dev.db"
JWT_SECRET="skill-track-dev-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:5173"

# Email service (optional in local dev; falls back to logged stream transport if SMTP_HOST is omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Skill-Track <noreply@skilltrack.local>"

# AI service (server-side only, never exposed to client; deterministic market-doc fallback when omitted)
AI_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
