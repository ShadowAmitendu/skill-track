# SkillTrack Frontend Environment Variables

# Backend API Origin (proxied via Vite in development to http://localhost:8080)
VITE_BACKEND_URL=http://localhost:8080

# Admin email for development login validation
# NOTE: The Spring Boot backend currently does not implement server-side authentication (e.g. JWT).
# This environment variable defines the authorized Admin email for client-side role session verification.
VITE_ADMIN_EMAIL=admin@skilltrack.com
