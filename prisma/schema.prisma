// Portable Prisma schema: uses standard SQLite types & string union constraints
// that migrate 1:1 to PostgreSQL by changing `provider` to "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  passwordHash String
  role         String          // "admin" | "trainee" | "cp"
  name         String
  status       String          @default("active") // "active" | "pending" | "rejected"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  trainee      Trainee?
  provider     CourseProvider?
}

model Trainee {
  id                Int             @id @default(autoincrement())
  userId            Int             @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String?
  location          String?
  roleCategory      String          @default("IT") // "IT" | "Non-IT"
  bio               String?
  lastProfileUpdate DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  skills            TraineeSkill[]
  enrollments       Enrollment[]
  certifications    Certification[]
  projects          Project[]
  employment        Employment?
  salaryHistory     SalaryHistory[]
  consent           Consent?
  followUps         FollowUp[]
  resumes           Resume[]
}

model CourseProvider {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  contactEmail   String
  website        String?
  description    String?
  approvalStatus String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  courses        Course[]
}

model SkillCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  skills      Skill[]
}

model Skill {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  categoryId    Int
  category      SkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  courseSkills  CourseSkill[]
  traineeSkills TraineeSkill[]
}

model Course {
  id            Int           @id @default(autoincrement())
  title         String
  description   String
  category      String
  providerId    Int
  provider      CourseProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  popularity    Int           @default(0)
  durationWeeks Int           @default(8)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  courseSkills  CourseSkill[]
  enrollments   Enrollment[]
}

model CourseSkill {
  courseId Int
  skillId  Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
}

model TraineeSkill {
  id        Int      @id @default(autoincrement())
  traineeId Int
  skillId   Int
  source    String   // "verified" | "detected"
  createdAt DateTime @default(now())
  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([traineeId, skillId, source])
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  traineeId   Int
  courseId    Int
  status      String    @default("enrolled") // "enrolled" | "completed" | "dropped" | "kicked"
  dropReason  String?
  kickReason  String?
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  trainee     Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([traineeId, courseId])
}

model Certification {
  id            Int       @id @default(autoincrement())
  traineeId     Int
  title         String
  issuer        String
  issuedAt      DateTime?
  credentialUrl String?
  trainee       Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int      @id @default(autoincrement())
  traineeId   Int
  title       String
  description String?
  repoUrl     String
  createdAt   DateTime @default(now())
  trainee     Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Employment {
  id        Int      @id @default(autoincrement())
  traineeId Int      @unique
  status    String   // "full_time" | "part_time" | "internship" | "self_employed" | "unemployed"
  role      String?
  company   String?
  salary    Int?
  reason    String?  // "break" | "actively_looking"
  updatedAt DateTime @updatedAt
  trainee   Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model SalaryHistory {
  id         Int      @id @default(autoincrement())
  traineeId  Int
  amount     Int
  role       String
  company    String
  recordedAt DateTime @default(now())
  trainee    Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Consent {
  id            Int      @id @default(autoincrement())
  traineeId     Int      @unique
  status        Boolean  @default(true)
  emailsStopped Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  trainee       Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id          Int       @id @default(autoincrement())
  traineeId   Int
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  note        String?
  channel     String    @default("email")
  trainee     Trainee   @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model Resume {
  id              Int      @id @default(autoincrement())
  traineeId       Int
  fileName        String
  path            String
  extractedTokens String   // JSON array of detected skill tokens
  uploadedAt      DateTime @default(now())
  trainee         Trainee  @relation(fields: [traineeId], references: [id], onDelete: Cascade)
}

model MarketDoc {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  path      String
  sourceUrl String?
  summary   String?
  updatedAt DateTime @updatedAt
}
